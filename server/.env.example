# Copy to .env and fill in. NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baitul-hasanah?retryWrites=true&w=majority

# Long random secret (at least 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma separated (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Only used by `npm run seed:admin` to create the FIRST admin (there is no public admin signup)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
